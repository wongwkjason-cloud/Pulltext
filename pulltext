name: Sync Google Doc to GitHub

on:
  schedule:
    # Runs every 5 minutes
    - cron: '*/5 * * * *'
  workflow_dispatch: # Allows manual trigger anytime

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repo
        uses: actions/checkout@v3

      - name: Fetch Text from Google Doc & Format JSON
        run: |
          # Fetch public export from Google Doc
          TEXT=$(curl -sL "https://docs.google.com/document/d/1Rwxge4if3ufZ3LlI0gT3cCsjSBOupoUXgYmIdTjGzSY/export?format=txt")
          
          # Sanitize quotes & create clean JSON object
          python3 -c "
          import json, os
          text = '''$TEXT'''.strip()
          with open('notes.json', 'w') as f:
              json.dump({'status': 'success', 'note': text}, f)
          "

      - name: Commit & Push Updated JSON
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add notes.json
          git diff-index --quiet HEAD || git commit -m "Auto-update notes.json"
          git push
